# Postgres connection string (Neon or Supabase).
# Neon:     postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Supabase: postgresql://postgres:PASSWORD@HOST:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/dosclub?sslmode=require"

# Secret used to sign auth session cookies (generate: openssl rand -base64 32)
AUTH_SECRET="replace-me"
